<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Network for Claude API + Gmail -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Microphone for meeting recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Screen capture for screenshots + system audio -->
    <key>com.apple.security.screen-recording</key>
    <true/>
    <!-- No sandbox — required for ad-hoc signed local apps to use ScreenCaptureKit -->
</dict>
</plist>
