<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>ActionItems</string>
    <key>CFBundleName</key>
    <string>Flaxie</string>
    <key>CFBundleIdentifier</key>
    <string>com.hari.actionitems</string>
    <key>CFBundleVersion</key>
    <string>3</string>
    <key>CFBundleShortVersionString</key>
    <string>3.0.0</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- Menu bar app — no dock icon -->
    <key>LSUIElement</key>
    <true/>
    <!-- Privacy descriptions -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>Flaxie captures your screen to extract action items from Slack, WhatsApp, and other apps.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Flaxie reads your calendar to detect upcoming meetings.</string>
    <!-- Custom URL scheme for Gmail OAuth callback -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.hari.actionitems</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>actionitems</string>
            </array>
        </dict>
    </array>
    <!-- App Transport Security — only HTTPS allowed -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
