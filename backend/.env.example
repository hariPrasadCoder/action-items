# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (use service role key for backend — NOT anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...

# JWT (generate a long random secret: openssl rand -hex 32)
JWT_SECRET=your-very-long-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=365

# Slack App credentials (from api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-domain.com/slack/callback

# Google OAuth (Web application type — from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# App base URL (for OAuth redirects)
APP_BASE_URL=http://localhost:8000
